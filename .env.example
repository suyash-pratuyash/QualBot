QUALBOT_ENV=development
QUALBOT_API_PREFIX=/api/v1
QUALBOT_DATABASE_URL=sqlite:///./qualbot.db
# Comma-separate additional allowed browser origins.
QUALBOT_CORS_ORIGINS=http://localhost:5173
# Public frontend configuration consumed by Vite, not a backend secret.
VITE_API_BASE_URL=http://localhost:8000/api/v1

QUALBOT_GEMINI_API_KEY=
QUALBOT_GEMINI_MODEL=gemini-2.5-flash
QUALBOT_GEMINI_TIMEOUT_SECONDS=8
QUALBOT_JWT_SECRET=dev-only-change-this-secret
QUALBOT_ADMIN_EMAIL=admin@qualbot.local
QUALBOT_ADMIN_PASSWORD=qualbot-demo
QUALBOT_CALENDLY_BOOKING_URL=
